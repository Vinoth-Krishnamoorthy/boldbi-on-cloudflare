{
  "name": "containers-template",
  "description": "Build a Container-enabled Worker",
  "cloudflare": {
    "label": "Containers Starter",
    "products": [
      "Workers",
      "Durable Objects",
      "Containers"
    ],
    "categories": [],
    "docs_url": "https://developers.cloudflare.com/containers/",
    "preview_image_url": "https://imagedelivery.net/_yJ02hpOMj_EnGvsU2aygw/5aba1fb7-b937-46fd-fa67-138221082200/public",
    "icon_urls": [
      "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/5ca0ca32-e897-4699-d4c1-6b680512f000/public"
    ]
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "hono": "4.11.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.3",
    "@types/node": "^26.6.5",
    "@vitest/runner": "4.1.10",
    "@vitest/snapshot": "4.1.10",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "^4.151.0"
  },
  "private": true,
  "scripts": {
    "cf-typegen": "wrangler types worker-configuration.d.ts --config fresh-poc/wrangler.normal.jsonc",
    "check": "tsc --noEmit -p fresh-poc/tsconfig.json && tsc --noEmit -p eval-poc/tsconfig.json",
    "deploy": "wrangler deploy --config fresh-poc/wrangler.normal.jsonc",
    "deploy:worker": "wrangler deploy --config fresh-poc/wrangler.normal.jsonc --containers-rollout=none",
    "deploy:eval": "wrangler deploy --config eval-poc/wrangler.eval.jsonc",
    "deploy:eval:worker": "wrangler deploy --config eval-poc/wrangler.eval.jsonc --containers-rollout=none",
    "dev": "wrangler dev --config fresh-poc/wrangler.normal.jsonc",
    "e2e:dev": "wrangler dev --config fresh-poc/wrangler.normal.jsonc --enable-containers=false",
    "start": "wrangler dev --config fresh-poc/wrangler.normal.jsonc",
    "test": "vitest run --config fresh-poc/vitest.config.ts && vitest run --config eval-poc/vitest.config.ts"
  },
  "type": "module"
}
